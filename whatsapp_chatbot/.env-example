# ===============================================
# SABISPEND - WhatsApp Money Assistant
# ===============================================

# Database
MONGO_URI=mongodb+srv://your-connection-string

# WhatsApp Configuration
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-verify-token

# ===============================================
# AI Services (all endpoints configurable)
# ===============================================

# Main AI Model (LLM for agent reasoning)
AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://your-ai-endpoint.com/v1
AI_MODEL=your-model-name

# Vision/OCR API (for invoice and sales receipt recognition)
VISION_API_URL=https://your-vision-endpoint.com/analyze
VISION_API_KEY=your-vision-api-key

# ===============================================
# Speech Services (Voice support for low-literacy users)
# ===============================================

# Hausa Language Services
HAUSA_STT_API_URL=https://your-stt-endpoint.com/ha/v1
HAUSA_TTS_BASE_URL=https://your-tts-endpoint.com/ha/v1
HAUSA_TTS_MODEL=tts-1
HAUSA_TTS_VOICE=female

# Igbo Language Services
IGBO_STT_API_URL=https://your-stt-endpoint.com/ig/v1
IGBO_TTS_BASE_URL=https://your-tts-endpoint.com/ig/v1
IGBO_TTS_MODEL=igbo-tts-model
IGBO_TTS_VOICE=female

# Yoruba Language Services
YORUBA_STT_API_URL=https://your-stt-endpoint.com/yo/v1
YORUBA_TTS_BASE_URL=https://your-tts-endpoint.com/yo/v1
YORUBA_TTS_MODEL=yoruba-tts-model
YORUBA_TTS_VOICE=female

# English Language Services
ENGLISH_STT_API_URL=https://your-stt-endpoint.com/en/v1
ENGLISH_TTS_BASE_URL=https://your-tts-endpoint.com/en/v1
ENGLISH_TTS_MODEL=nigerian-english-tts
ENGLISH_TTS_VOICE=female2

# ===============================================
# BMONI Integration (Financial Infrastructure)
# !! UPDATE THESE WHEN YOU RECEIVE BMONI API CREDENTIALS !!
# ===============================================

# BMONI Wallet API (for savings, transfers, balance checks)
BMONI_BASE_URL=https://embedded-dev.bmoni.com
BMONI_API_KEY=your-bmoni-api-key
BMONI_SECRET_KEY=your-bmoni-secret-key

# BMONI Webhook Secret (for payment notifications)
BMONI_WEBHOOK_SECRET=your-bmoni-webhook-secret

# EVM Wallet Encryption (for server-side signing)
# ⚠️ SECURITY: Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store this key securely! If lost, users cannot sign transactions
WALLET_ENCRYPTION_KEY=your-fernet-encryption-key-here
